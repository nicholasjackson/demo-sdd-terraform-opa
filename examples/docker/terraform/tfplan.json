{
  "format_version": "1.2",
  "terraform_version": "1.5.0",
  "resource_changes": [
    {
      "address": "docker_image.vault",
      "mode": "managed",
      "type": "docker_image",
      "name": "vault",
      "provider_name": "registry.terraform.io/kreuzwerker/docker",
      "change": {
        "actions": ["create"],
