        "after_unknown": {
          "id": true,
          "image_id": true,
          "repo_digest": true
        }
      }
    },
    {
      "address": "docker_network.vault",
      "mode": "managed",
      "type": "docker_network",
      "name": "vault",
      "provider_name": "registry.terraform.io/kreuzwerker/docker",
      "change": {
        "actions": ["create"],
        "before": null,
        "after": {
          "name": "vault-network",
          "driver": "bridge"
        },
        "after_unknown": {
          "id": true
        }
      }
    },
    {
      "address": "docker_volume.vault_data",
      "mode": "managed",
      "type": "docker_volume",
      "name": "vault_data",
      "provider_name": "registry.terraform.io/kreuzwerker/docker",
      "change": {
        "actions": ["create"],
        "before": null,
        "after": {
          "name": "vault-data"
        },
        "after_unknown": {
          "id": true
        }
      }
    },
    {
      "address": "docker_volume.vault_logs",
      "mode": "managed",
      "type": "docker_volume",
      "name": "vault_logs",
      "provider_name": "registry.terraform.io/kreuzwerker/docker",
      "change": {
        "actions": ["create"],
        "before": null,
        "after": {
          "name": "vault-logs"
        },
        "after_unknown": {
          "id": true
        }
      }
    },
    {
      "address": "docker_container.vault",
      "mode": "managed",
      "type": "docker_container",
      "name": "vault",
      "provider_name": "registry.terraform.io/kreuzwerker/docker",
      "change": {
        "actions": ["create"],
        "before": null,
        "after": {
          "name": "vault",
          "image": "sha256:abc123def456",
          "command": ["server", "-dev", "-dev-root-token-id=root"],
          "env": [
            "VAULT_DEV_ROOT_TOKEN_ID=root",
            "VAULT_DEV_LISTEN_ADDRESS=0.0.0.0:8200",
            "VAULT_ADDR=http://127.0.0.1:8200"
          ],
          "ports": [
            {
              "internal": 8200,
              "external": 8200,
              "protocol": "tcp"
            }
          ],
          "networks_advanced": [
            {
              "name": "vault-network"
            }
          ],
          "volumes": [
            {
              "volume_name": "vault-data",
              "container_path": "/vault/data"
            },
            {
              "volume_name": "vault-logs",
              "container_path": "/vault/logs"
            }
          ],
          "read_only": true,
          "capabilities": {
            "add": ["IPC_LOCK"],
            "drop": ["ALL"]
          },
          "restart": "unless-stopped",
          "healthcheck": {
            "test": ["CMD", "vault", "status", "-address=http://127.0.0.1:8200"],
            "interval": "10s",
            "timeout": "5s",
            "retries": 3,
            "start_period": "10s"
          }
        },
        "after_unknown": {
          "id": true,
          "exit_code": true,
          "container_logs": true
        }
      }
    }
  ]
